# Both values below are optional. src/config/supabase.js carries the project
# URL and the publishable key, so a clone runs with no .env at all. Set these
# only to point the app at a different Supabase project — a branch database, or
# a local stack.
#
# Stripe secrets, the service-role key and the price ids belong to the Supabase
# project and never to this repo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
